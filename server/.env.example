NODE_ENV=development
HOST=0.0.0.0
PORT=3000
TZ=Asia/Seoul
PUBLIC_APP_URL=https://nxdi.vercel.app
DATABASE_URL=mysql://root:password@host.docker.internal:3306/nxdi
APP_SESSION_SECRET=replace-with-at-least-32-characters
DATA_ENCRYPTION_KEY_BASE64=
ADMIN_EMAILS=
CRON_SECRET=
DATAGSM_CLIENT_ID=
DATAGSM_CLIENT_SECRET=
DATAGSM_REDIRECT_URI=https://nxdi.vercel.app/api/auth/datagsm/callback
KRX_AUTH_KEY=
OPENDART_API_KEY=
FMP_API_KEY=

# All six SMTP/sender settings are required. Missing settings prevent server startup.
# Supply SMTP_PASSWORD through a server secret; this empty example will not start.
SMTP_HOST=mail.kimtaeeun.site
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@kimtaeeun.site
SMTP_PASSWORD=
MAIL_FROM="NXDI <contact@kimtaeeun.site>"
MAIL_BATCH_SIZE=20
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
