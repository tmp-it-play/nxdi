DATAGSM_CLIENT_ID=
DATAGSM_CLIENT_SECRET=
DATAGSM_REDIRECT_URI=http://localhost:3000/api/auth/datagsm/callback
APP_SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=mysql://user:password@host:3306/nxdi

OPENDART_API_KEY=
FMP_API_KEY=
KRX_AUTH_KEY=

ADMIN_EMAILS=admin@gsm.hs.kr
CRON_SECRET=

# Server-only email settings. Never expose SMTP_PASSWORD through NEXT_PUBLIC_*.
# All six SMTP/sender settings are required; supply SMTP_PASSWORD before startup.
SMTP_HOST=mail.kimtaeeun.site
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@kimtaeeun.site
SMTP_PASSWORD=
MAIL_FROM="NXDI <contact@kimtaeeun.site>"
MAIL_BATCH_SIZE=20
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
